{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketPolicyStatus",
        "s3:GetBucketPolicy",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::csce412nathanlam-me-site"
    },
    {
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::csce412nathanlam-me-site/*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudfront:GetDistribution",
        "cloudfront:GetDistributionConfig",
        "cloudfront:GetInvalidation"
      ],
      "Resource": "arn:aws:cloudfront::111859959580:distribution/E3GXXYV0NZ7SL9"
    },
    {
      "Effect": "Allow",
      "Action": "cloudfront:GetOriginAccessControl",
      "Resource": "arn:aws:cloudfront::111859959580:origin-access-control/*"
    },
    {
      "Effect": "Allow",
      "Action": "acm:DescribeCertificate",
      "Resource": "arn:aws:acm:us-east-1:111859959580:certificate/d8f93a73-ce3a-4f44-902c-4deee6e18a71"
    },
    {
      "Effect": "Allow",
      "Action": "route53:ListHostedZones",
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "route53:GetHostedZone",
        "route53:ListResourceRecordSets"
      ],
      "Resource": "arn:aws:route53:::hostedzone/Z03906172QB5FBUEDNYFU"
    },
    {
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::csce412nathanlam-me-site/*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudfront:UpdateDistribution",
        "cloudfront:CreateInvalidation"
      ],
      "Resource": "arn:aws:cloudfront::111859959580:distribution/E3GXXYV0NZ7SL9"
    },
    {
      "Effect": "Allow",
      "Action": "route53:ChangeResourceRecordSets",
      "Resource": "arn:aws:route53:::hostedzone/Z03906172QB5FBUEDNYFU"
    }
  ]
}
